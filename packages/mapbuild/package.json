{
  "name": "@majority-map/mapbuild",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builds the tabletop board geometry for every map from public boundary files.",
  "scripts": {
    "fetch": "node src/fetch.ts",
    "build": "node src/build.ts",
    "maps": "node src/fetch.ts && node src/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "d3-geo": "3.1.0",
    "polylabel": "1.1.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/polylabel": "1.1.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5"
  }
}
