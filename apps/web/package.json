{
  "name": "@majority-map/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The web game. For now: the board lab, which draws every board with sample standings.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@majority-map/board": "workspace:*",
    "@majority-map/content": "workspace:*",
    "@majority-map/core": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.5"
  }
}
